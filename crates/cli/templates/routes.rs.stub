use crate::config::AppConfig;
use berserk::{response, App, Request, Result};

pub fn register(app: &mut App) -> Result<()> {
    app.route().get("/", |request: Request| {
        response().text(request.config::<AppConfig>()?.name.clone())
    })?;
    app.route().get("/health", || response().text("OK"))?;
    Ok(())
}
